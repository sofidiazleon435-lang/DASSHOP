<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /dasshop/

    # Si el archivo o carpeta existe físicamente, cárgalo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # De lo contrario, envía la petición a index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>